<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background layer (BUILD_SPECS §4b item 4). A flat fill and nothing else: the
  adaptive-icon mask, parallax and any launcher-side scaling are all applied to this layer, and a
  flat colour is the one thing that cannot break under any of them. Vector, so there is not a single
  raster asset in the app and no new dependency.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF1D2433"
        android:pathData="M0,0h108v108h-108z" />
</vector>
