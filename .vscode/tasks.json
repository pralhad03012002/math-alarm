{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build debug APK",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Install on device",
      "type": "shell",
      "command": "./gradlew installDebug",
      "problemMatcher": []
    },
    {
      "label": "Build + install + launch",
      "type": "shell",
      "command": "./gradlew installDebug && \"$ANDROID_HOME/platform-tools/adb\" shell am start -n com.mathalarm/.MainActivity",
      "problemMatcher": []
    },
    {
      "label": "Logcat (app only)",
      "type": "shell",
      "command": "\"$ANDROID_HOME/platform-tools/adb\" logcat --pid=$(\"$ANDROID_HOME/platform-tools/adb\" shell pidof -s com.mathalarm)",
      "problemMatcher": []
    },
    {
      "label": "List devices",
      "type": "shell",
      "command": "\"$ANDROID_HOME/platform-tools/adb\" devices -l",
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "./gradlew testDebugUnitTest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "./gradlew clean",
      "problemMatcher": []
    }
  ]
}
