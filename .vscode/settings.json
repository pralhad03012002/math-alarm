{
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true
  },
  "search.exclude": {
    "**/.gradle": true,
    "**/build": true
  },
  "kotlin.languageServer.enabled": true,
  "[kotlin]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "terminal.integrated.env.osx": {
    "ANDROID_HOME": "${env:HOME}/Library/Android/sdk",
    "JAVA_HOME": "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
  }
}
